# ─────────────────────────────────────────────────────────────
# 데이터베이스 (Neon Postgres)
# ─────────────────────────────────────────────────────────────
# changelog / roadmap / feedback 이 여기에 저장된다.
# https://console.neon.tech → 프로젝트 → Connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
# 쓰기 API 키 — 에이전트 스킬이 이걸로 changelog/roadmap 을 넣는다
# ─────────────────────────────────────────────────────────────
# 아무 난수나 쓴다:  openssl rand -hex 32
# 이 값이 없으면 모든 쓰기 API 가 401 이다(안전한 기본값).
# DB 접속 문자열을 스킬에 주지 말 것 — 이 키가 그 자리를 대신한다.
ADMIN_API_KEY=

# ─────────────────────────────────────────────────────────────
# 선택 — 없으면 해당 기능만 조용히 꺼진다
# ─────────────────────────────────────────────────────────────
# GA4 측정 ID. 없으면 GA 스크립트를 아예 로드하지 않는다.
NEXT_PUBLIC_GA_ID=

# GitHub 읽기 토큰(public_repo 권한 불필요, 스코프 없는 토큰으로 충분).
# 없으면 시간당 60회 제한 → 별 개수 배지가 가끔 비어 보인다.
GITHUB_TOKEN=
